{
  "name": "coupler-social-media-backend",
  "version": "0.0.1",
  "scripts": {
    "build:old": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "build": "tsup",
    "prepare": "husky || true",
    "dev": "tsnd --respawn --transpile-only --exit-child src/server.ts",
    "start:local:old": "tsnd --respawn --transpile-only --exit-child src/server.ts",
    "migrate:local": "prisma migrate dev",
    "generate:local": "prisma generate",
    "db:setup:local": "pnpm run generate:local && pnpm run migrate:local && pnpm run prisma:seed",
    "prisma:studio": "prisma studio",
    "prisma:seed": "pnpx ts-node prisma/seed.ts",
    "db:setup": "pnpm run prisma:generate && pnpm run prisma:migrate && pnpm run prisma:seed",
    "start:prod:old": "pnpm run db:setup && node dist/server.js",
    "generate": "pnpx prisma generate",
    "migrate:local:reset": "dotenv -e .env.local -- pnpx prisma migrate reset",
    "migrate:dev:reset": "dotenv -e .env.dev -- pnpx prisma migrate reset",
    "migrate:local:up": "dotenv -e .env.local -- pnpx prisma migrate dev",
    "migrate:local:deploy": "dotenv -e .env.local -- pnpx prisma migrate deploy",
    "migrate:local:status": "dotenv -e .env.local -- pnpx prisma migrate status",
    "migrate:local:resolve": "dotenv -e .env.local -- pnpx prisma migrate resolve --rolled-back ",
    "migrate:dev:up": "dotenv -e .env.dev -- pnpx prisma migrate deploy",
    "migrate:dev:status": "dotenv -e .env.dev -- pnpx prisma migrate status",
    "migrate:dev:resolve": "dotenv -e .env.dev -- pnpx prisma migrate resolve --rolled-back ",
    "migrate:dev:deploy": "pnpx dotenv -e .env.dev -- pnpx prisma migrate deploy",
    "seed:local:up": "dotenv -e .env.local -- tsx prisma/seeds/up.ts",
    "seed:local:down": "dotenv -e .env.local -- tsx prisma/seeds/down.ts",
    "seed:dev:up": "dotenv -e .env.dev -- tsx prisma/seeds/up.ts",
    "seed:dev:down": "dotenv -e .env.dev -- tsx prisma/seeds/down.ts",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint --fix .",
    "format:fix": "pnpx prettier --write . --log-level silent",
    "lint:all": "pnpm lint && pnpm lint:fix && pnpm format:fix",
    "start:local": "cross-env NODE_ENV=local tsx watch src/server | pino-pretty",
    "start:dev": "cross-env NODE_ENV=development node dist/server.js",
    "start:staging": "cross-env NODE_ENV=staging node dist/server.js",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "start:build:local": "cross-env NODE_ENV=local node dist/server.js",
    "postinstall": "pnpm generate && pnpm migrate:local:up && pnpm seed:local:up",
    "db:local:pull": "dotenv -e .env.local -- pnpx prisma db pull",
    "db:dev:pull": "dotenv -e .env.dev -- pnpx prisma db pull",
    "docker:local:up": "docker compose -f docker-compose.local.yaml --env-file .env.local up -d",
    "docker:local:down": "docker compose -f docker-compose.local.yaml down",
    "docker:dev:up": "docker compose -f docker-compose.dev.yaml --env-file .env.dev up -d --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yaml down",
    "clean": "rimraf node_modules dist pnpm-lock.yaml",
    "resolve:local": "dotenv -e .env.local -- pnpx prisma migrate resolve --applied '20250526071906_v1_2'",
    "rollback:local": "dotenv -e .env.local -- pnpx prisma migrate resolve --rolled-back '20250526071906_v1_2'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.842.0",
    "@aws-sdk/s3-request-presigner": "^3.842.0",
    "@fastify/autoload": "^6.3.1",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "13.0.1",
    "@fastify/jwt": "9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/redis": "7.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@fastify/under-pressure": "^9.0.3",
    "@prisma/client": "^6.16.1",
    "ajv-errors": "^3.0.0",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "fastify-metrics": "^12.1.0",
    "fastify-plugin": "^5.0.1",
    "nanoid": "^5.1.5",
    "pino": "^9.7.0",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "undici": "^7.11.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.0.12",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "pg": "^8.16.3",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
